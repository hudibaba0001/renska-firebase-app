rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper functions for common checks ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isNotDeleted() {
      // For read operations, only allow if the document is not soft-deleted
      // Also handles documents that might not yet have the 'deleted' field (old data migrated to false)
      return resource.data.deleted == false || !('deleted' in resource.data);
    }

    // Function to check if the requesting user is an admin of the specified company
    // Assumes custom claim 'adminOf' is an array of company IDs the user is an admin for.
    function isCompanyAdmin(companyId) {
      return isSignedIn() &&
             request.auth.token.adminOf is list && // Ensure it's a list
             request.auth.token.adminOf.hasAny([companyId]); // User is admin of this company
    }

    // Function to check if the requesting user is a super admin
    // Assumes custom claim 'superAdmin' is set to true.
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.superAdmin == true;
    }

    // Function to check if the requesting user is the owner of the document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Helper for personnummer validation (basic format check)
    // TODO: Add Cloud Function for full personnummer validation (including checksum like Luhn algorithm) before write.
    function isValidPersonnummerFormat(personnummer) {
      return personnummer is string && personnummer.matches('^[0-9]{8}-[0-9]{4}$');
    }

    // --- /users/{userId} Collection ---
    // Users can only read/write their own profile (if not deleted), super admins can manage all user profiles.
    match /users/{userId} {
      allow read: if isOwner(userId) && isNotDeleted() || isSuperAdmin();
      allow create: if isSignedIn(); // Allow any signed-in user to create their own user document
      allow update: if isOwner(userId) && isNotDeleted() || isSuperAdmin(); // Owner or super admin can update
      // Soft-delete is handled by setting 'deleted: true' in app logic
      allow delete: if false; // Disallow direct hard deletes via client for safety
    }

    // --- /companies/{companyId} Collection (Tenants) ---
    match /companies/{companyId} {
      // Only super admins can create new companies.
      allow create: if isSuperAdmin();

      // Company admins can read their own company's data if not deleted. Super admins can read all.
      allow read: if (isCompanyAdmin(companyId) || isSuperAdmin()) && isNotDeleted();

      // Company admins can update their company's details, if not deleted. Super admins can update all.
      // IMPORTANT: Stricter update rule to prevent arbitrary changes to 'deleted' field
      allow update: if (isCompanyAdmin(companyId) || isSuperAdmin()) && isNotDeleted() && (
        // Allow all updates if 'deleted' field is NOT being changed, OR
        // if 'deleted' field IS being changed, ensure it's only from false to true.
        // This rule covers the 'deleted: true' soft-delete operation!
        !('deleted' in request.resource.data) || // If 'deleted' field is not part of the update payload
        (request.resource.data.deleted == true && resource.data.deleted == false) // OR if it's changing from false to true
      );

      // Disallow direct hard deletes via client. Soft-delete is managed by setting 'deleted: true' via app logic/Cloud Function.
      allow delete: if false;
    }

    // --- Subcollections within /companies/{companyId} ---

    // /companies/{companyId}/services/{serviceId}
    match /companies/{companyId}/services/{serviceId} {
      allow read: if (isCompanyAdmin(companyId) || isSuperAdmin()) && isNotDeleted();
      // For creation, consent is required.
      allow create: if (isCompanyAdmin(companyId) || isSuperAdmin()) && 
                       request.resource.data.get('consent', false) == true;
      allow update: if (isCompanyAdmin(companyId) || isSuperAdmin()) && isNotDeleted();
      allow delete: if false; // Disallow direct hard deletes via client (use soft-delete)
    }

    // /companies/{companyId}/customers/{customerId}
    match /companies/{companyId}/customers/{customerId} {
      allow read: if (isCompanyAdmin(companyId) || isSuperAdmin()) && isNotDeleted();
      // For creation, consent is required. If personnummer is provided, ensure basic format and RUTEligible is true.
      allow create: if (isCompanyAdmin(companyId) || isSuperAdmin()) &&
                       request.resource.data.get('consent', false) == true &&
                       (!('personnummer' in request.resource.data) || 
                        (isValidPersonnummerFormat(request.resource.data.personnummer) && 
                         request.resource.data.get('RUTEligible', false) == true));
      allow update: if (isCompanyAdmin(companyId) || isSuperAdmin()) && isNotDeleted();
      allow delete: if false; // Disallow direct hard deletes via client (use soft-delete)
    }

    // /companies/{companyId}/bookings/{bookingId}
    match /companies/{companyId}/bookings/{bookingId} {
      allow read: if (isCompanyAdmin(companyId) || isSuperAdmin()) && isNotDeleted();
      // For creation, consent is required. If personnummer is provided, ensure basic format and RUTEligible is true.
      allow create: if (isCompanyAdmin(companyId) || isSuperAdmin()) &&
                       request.resource.data.get('consent', false) == true &&
                       (!('personnummer' in request.resource.data) || 
                        (isValidPersonnummerFormat(request.resource.data.personnummer) && 
                         request.resource.data.get('RUTEligible', false) == true));
      allow update: if (isCompanyAdmin(companyId) || isSuperAdmin()) && isNotDeleted();
      allow delete: if false; // Disallow direct hard deletes via client (use soft-delete)
    }

    // /companies/{companyId}/coupons/{couponId}
    match /companies/{companyId}/coupons/{couponId} {
      allow read: if (isCompanyAdmin(companyId) || isSuperAdmin()) && isNotDeleted();
      allow create: if (isCompanyAdmin(companyId) || isSuperAdmin());
      allow update: if (isCompanyAdmin(companyId) || isSuperAdmin()) && isNotDeleted();
      allow delete: if false; // Disallow direct hard deletes via client (use soft-delete)
    }

    // --- API Versioning Support ---
    // TODO: Implement version-specific rules as the API evolves
    match /v1/{document=**} {
      // For now, delegate to existing rules structure
      // In the future, this can contain version-specific security logic
      allow read, write: if false; // Placeholder - implement version-specific rules here
    }

    match /v2/{document=**} {
      // Future API version support
      allow read, write: if false; // Placeholder for future versions
    }

    // --- Default deny for all other paths ---
    // This is important to ensure only explicitly allowed paths are accessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}