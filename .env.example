# SwedPrime Environment Variables
# Copy this file to .env and fill in your actual values

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Security
VITE_ENCRYPTION_KEY=generate_a_strong_32_character_key_here
VITE_SUPER_ADMIN_EMAIL=admin@yourcompany.com

# Stripe Configuration
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Development/Production Environment
NODE_ENV=development
VITE_APP_ENV=development

# Security Keys (Generate these with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
VITE_JWT_SECRET=generate_a_strong_jwt_secret_here
VITE_SESSION_SECRET=generate_a_strong_session_secret_here

# Rate Limiting
VITE_RATE_LIMIT_WINDOW_MS=60000
VITE_RATE_LIMIT_MAX_REQUESTS=100

# Logging
VITE_LOG_LEVEL=info
VITE_ENABLE_CONSOLE_LOGS=false
